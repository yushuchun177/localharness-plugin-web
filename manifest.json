{
  "id": "web",
  "name": "网页搜索与获取",
  "name_en": "Web search & fetch",
  "version": "0.1.0",
  "description": "抓取网页正文（curl 转纯文本）和 DuckDuckGo 关键词搜索，把结果喂给模型。",
  "description_en": "Fetch page text and search DuckDuckGo.",
  "author": "yushuchun177",
  "homepage": "https://github.com/yushuchun177/localharness-plugin-web",
  "min_app": "0.1.0",
  "requires": {
    "os": "Windows 10+",
    "deps": [
      "PowerShell"
    ],
    "disk": "< 1 MB",
    "memory": "约 15 MB",
    "network": true
  },
  "settings": [
    {
      "key": "max_chars",
      "label": "抓取上限（字符）",
      "type": "int",
      "default": 6000,
      "help": "网页转文本后最多返回多少字",
      "min": 200,
      "max": 50000,
      "unit": "字符"
    }
  ],
  "tools": [
    {
      "name": "web_fetch",
      "description": "抓取一个网页并返回纯文本（去掉标签），最多返回 6000 字。",
      "params": {
        "url": "string，完整网址",
        "max_chars": "int，可选，默认 6000"
      },
      "level": "read",
      "needs": [
        "联网"
      ],
      "async": true
    },
    {
      "name": "web_search",
      "description": "用 DuckDuckGo 搜索关键词，返回标题 + 链接 + 摘要（前 8 条）。",
      "params": {
        "query": "string，搜索词",
        "limit": "int，可选，默认 8"
      },
      "level": "read",
      "needs": [
        "联网"
      ],
      "async": true
    }
  ]
}
